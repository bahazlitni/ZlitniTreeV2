// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PowerType {
  ROOT
  ADMIN
  MEMBER
  ANON
}

enum OTPType {
  LOGIN
  RESET_PASSWORD
}

enum LoginMode {
  PASSWORD_ONLY
  PASSWORDLESS
  PASSWORD_AND_OTP
}

model Person {
  id Int @id @default(autoincrement())

  parentMarriageId Int? @map("parent_marriage_id")

  firstNameArabic  String? @map("firstname_arabic")
  middleNameArabic String? @map("middlename_arabic")
  lastNameArabic   String? @map("lastname_arabic")

  firstName  String? @map("firstname")
  middleName String? @map("middlename")
  lastName   String? @map("lastname")

  isMale  Boolean? @map("is_male")
  isAlive Boolean? @map("is_alive")

  birthYear        Int?    @map("birth_year")
  birthMonth       Int?    @map("birth_month")
  birthDay         Int?    @map("birth_day")
  birthCity        String? @map("birth_city")
  birthCountryCode String? @map("birth_country")

  deathYear        Int?    @map("death_year")
  deathMonth       Int?    @map("death_month")
  deathDay         Int?    @map("death_day")
  deathCity        String? @map("death_city")
  deathCountryCode String? @map("death_country")

  marriagesAsFirstPartner  Marriage[] @relation("MarriageFirstPartner")
  marriagesAsSecondPartner Marriage[] @relation("MarriageSecondPartner")
  parentMarriage           Marriage?  @relation("ParentMarriage", fields: [parentMarriageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastNameArabic])
  @@index([birthYear])
  @@index([birthCountryCode])
  @@map("persons")
}

model Marriage {
  id Int @id @default(autoincrement())

  firstPartnerId  Int  @map("first_partner_id")
  secondPartnerId Int? @map("second_partner_id")

  // Wedding date
  weddingYear  Int? @map("wedding_year")
  weddingMonth Int? @map("wedding_month")
  weddingDay   Int? @map("wedding_day")

  isDivorced Boolean @default(false) @map("is_divorced")

  firstPartner  Person   @relation("MarriageFirstPartner", fields: [firstPartnerId], references: [id], onDelete: Restrict)
  secondPartner Person?  @relation("MarriageSecondPartner", fields: [secondPartnerId], references: [id], onDelete: Restrict)
  children      Person[] @relation("ParentMarriage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([firstPartnerId, secondPartnerId])
  @@index([firstPartnerId])
  @@index([secondPartnerId])
  @@map("marriages")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  powerType           PowerType            @default(ANON) @map("power_type")
  loginMode           LoginMode            @default(PASSWORDLESS) @map("login_mode")
  lastLoginAt         DateTime?            @map("last_login_at")
  otpChallenges       OTPChallenge[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([powerType])
  @@map("users")
}

model OTPChallenge {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  codeHash           String    @map("code_hash")
  challengeTokenHash String?   @map("challenge_token_hash")
  type               OTPType
  attempts           Int       @default(0)
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([challengeTokenHash])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id                 String    @id @default(cuid())
  tokenHash          String    @map("token_hash")
  userId             String    @map("user_id")
  expiresAt          DateTime  @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  revokedAt          DateTime? @map("revoked_at")
  lastUsedAt         DateTime? @map("last_used_at")
  createdByIpAddress String?   @map("created_by_ip_address") @db.VarChar(100)
  createdByUserAgent String?   @map("created_by_user_agent") @db.Text
  replacedByTokenId  String?   @map("replaced_by_token_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
